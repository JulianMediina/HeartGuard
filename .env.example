# Copie este archivo como .env y ajuste los valores. Nunca suba .env al repositorio.

# --- Django ---
DJANGO_DEBUG=True
# Genere una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (MySQL portátil local, ver README) ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=heartguarddb
DB_TEST_NAME=test_heartguarddb
DB_USER=heartguard
DB_PASSWORD=heartguard_local
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Correo (en local los correos se imprimen en la consola) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HeartGuard <no-reply@heartguard.local>

# --- Frontend Angular ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- Herramienta de IA ---
# Carpeta con los artefactos del modelo (vacío = valor por defecto de HeartGuard.ml)
HEARTGUARD_MODEL_DIR=
# Enviar alerta por correo al crear un informe de riesgo alto
HEARTGUARD_ALERTA_AUTOMATICA=True

# --- Límites de peticiones ---
AUTH_THROTTLE_RATE=20/min
REENTRENAR_THROTTLE_RATE=3/hour
